{
  "manifest_version": 3,
  "name": "Voice File for WhatsApp",
  "version": "1.0.3",
  "description": "Choose a local audio file beside the WhatsApp microphone and prepare it as a voice message.",
  "minimum_chrome_version": "114",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
